# ========================================================
# Ceyora 360 Full-Stack Monorepo Environment Configuration
# ========================================================
# Copy this file to .env before starting Docker Compose or deploying to production.

# --- Database (PostgreSQL) ---
POSTGRES_USER=ceyora
POSTGRES_PASSWORD=replace_with_a_strong_random_password_in_production
POSTGRES_DB=ceyora
POSTGRES_PORT=5432

# --- Backend API Server (@ceyora/server) ---
NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://ceyora:replace_with_a_strong_random_password_in_production@localhost:5432/ceyora?schema=public
DIRECT_URL=postgresql://ceyora:replace_with_a_strong_random_password_in_production@localhost:5432/ceyora?schema=public
CORS_ORIGIN=http://localhost:3000,https://ceyora.lk,https://app.ceyora.lk
SETUP_TOKEN=generate_a_random_32_char_hex_token_for_initial_admin_setup
LOG_REQUESTS=0

# --- Frontend Web Dashboard (@ceyora/web) ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_APP_NAME=Ceyora Tuition Management & BI
NEXT_PUBLIC_DEFAULT_CURRENCY=LKR
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_ENABLE_OFFLINE_MOCK_FALLBACK=true

# --- PayHere Sri Lanka Payment Gateway ---
# Obtain from https://www.payhere.lk merchant portal
PAYHERE_MERCHANT_ID=1224890
PAYHERE_SECRET=897ab3c49ef01289de674a2110bc88
PAYHERE_SANDBOX=1
NEXT_PUBLIC_PAYHERE_MERCHANT_ID=1224890
NEXT_PUBLIC_PAYHERE_MODE=sandbox

# --- Sri Lanka SMS Notification Gateway ---
# Options: mobitel, dialog, or twilio
SMS_GATEWAY_PROVIDER=mobitel
SMS_API_URL=https://msmsenterprise.mobitel.lk/api/v1/sms/send
SMS_API_KEY=
SMS_SENDER_ID=CEYORA

# --- Compliance: Sri Lanka PDPA (Act No. 9 of 2022) ---
PDPA_AUDIT_LOG_ENABLED=1
PDPA_DATA_RETENTION_DAYS=2555
