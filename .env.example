# ============================================
# Ceyora (EduBI) - Environment Variables
# ============================================

# ---------- Database ----------
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/ceyora
DATABASE_URL_SYNC=postgresql://postgres:password@localhost:5432/ceyora

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379/0

# ---------- JWT / Auth ----------
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- Next.js ----------
# Data source: "mock" (browser-local demo store) or "api" (Express backend in apps/server)
NEXT_PUBLIC_DATA_SOURCE=mock
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_APP_NAME=Ceyora
NEXT_PUBLIC_DEFAULT_LOCALE=en

# ---------- File Storage ----------
# Cloudflare R2 or AWS S3
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ---------- WhatsApp Cloud API ----------
WHATSAPP_API_VERSION=v18.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ---------- SMS Gateway ----------
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=

# ---------- Payment Gateways ----------
# PayHere
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX=true

# WebXPay
WEBXPAY_API_KEY=
WEBXPAY_SANDBOX=true

# ---------- WeasyPrint ----------
WEASYPRINT_PATH=weasyprint

# ---------- Super Admin ----------
SUPER_ADMIN_EMAIL=admin@ceyora.lk
SUPER_ADMIN_PASSWORD=changeme123

# ---------- Enterprise Licensing ----------
LICENSE_KEY=
HEARTBEAT_URL=
