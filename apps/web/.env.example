# Ceyora Frontend Environment Configuration
# Copy this file to .env.local for local development or set these variables in your hosting provider (Vercel, Cloudflare, Docker).

# Backend API URL (Points to @ceyora/server)
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Application Metadata
NEXT_PUBLIC_APP_NAME=Ceyora Tuition Management & BI
NEXT_PUBLIC_DEFAULT_CURRENCY=LKR
NEXT_PUBLIC_DEFAULT_LOCALE=en

# PayHere Payment Gateway Client-Side Config
NEXT_PUBLIC_PAYHERE_MERCHANT_ID=1224890
NEXT_PUBLIC_PAYHERE_MODE=sandbox

# Offline Mode & Mock Store Failover (true = fallback to mock data when API is unreachable)
NEXT_PUBLIC_ENABLE_OFFLINE_MOCK_FALLBACK=true
