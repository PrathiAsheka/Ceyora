{
  "name": "@ceyora/server",
  "version": "0.1.0",
  "private": true,
  "description": "Ceyora REST API: Express + Prisma + PostgreSQL",
  "type": "commonjs",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node -e \"require('fs').cpSync('src/generated','dist/src/generated',{recursive:true})\"",
    "lint": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --tsconfig ../web/tsconfig.json prisma/seed.ts",
    "db:reset": "prisma migrate reset --force --skip-seed && npm run db:seed",
    "vercel-build": "prisma generate && prisma migrate deploy",
    "postinstall": "node -e \"try { require('child_process').execSync('prisma generate', {stdio:'ignore'}) } catch (e) {}\""
  },
  "prisma": {
    "seed": "tsx --tsconfig ../web/tsconfig.json prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "cors": "2.8.6",
    "express": "4.22.3",
    "zod": "3.24.4"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "4.17.23",
    "@types/node": "^20.14.0",
    "prisma": "6.19.3",
    "tsx": "4.19.4",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
