// Ceyora tuition management - PostgreSQL schema.
//
// Every business row belongs to exactly one Institute (instituteId), and
// deleting an institute removes everything under it. API responses keep the
// snake_case shapes the web app already uses (see src/mappers.ts).
//
// Naming follows the original spec: `Payment` is a student's bill for one
// class and billing cycle (amountBilled / amountPaid / balance / status).
// Money received from a guardian is a `PaymentTransaction`, split over bills
// oldest-first through `PaymentAllocation` rows; any unapplied part is the
// student's credit and rolls into the next cycle.

generator client {
  provider = "prisma-client-js"
  // Generated inside this package so Vercel bundles the query engine with the function.
  output   = "../src/generated/prisma"
  // "native" for local development, rhel-openssl-3.0.x for Vercel's Node runtime.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Pooled connection used by the API at runtime (e.g. Neon "-pooler" URL).
  url       = env("DATABASE_URL")
  // Direct (non-pooled) connection used by migrations.
  directUrl = env("DIRECT_URL")
}

enum Medium {
  SINHALA
  ENGLISH
  TAMIL
}

enum CompensationType {
  PERCENTAGE
  FLAT_STUDENT
  HOURLY_RATE
}

enum StaffPayType {
  MONTHLY
  DAILY
  HOURLY
}

enum ActiveStatus {
  ACTIVE
  INACTIVE
}

enum EnrollmentStatus {
  ACTIVE
  INACTIVE
  TRANSFERRED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum MarkedBy {
  QR_SCAN
  MANUAL
}

enum PaymentStatus {
  PAID
  PARTIAL
  PENDING
  OVERDUE
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  MOBILE_WALLET
  ONLINE
}

enum ExpenseStatus {
  PAID
  UNPAID
}

enum PayeeType {
  TEACHER
  STAFF
}

enum AdvanceStatus {
  REQUESTED
  PAID
  REJECTED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum UserRole {
  SUPER_ADMIN
  TEACHER
  CLASS_ADMIN
}

enum AccountStatus {
  ACTIVE
  DISABLED
}

enum InvitationStatus {
  PENDING
  USED
  REVOKED
}

model Institute {
  id                 String   @id @default(cuid())
  name               String
  logo               String?
  address            String?
  cutOffDay          Int      @default(10) @map("cut_off_day")
  registrationNumber String?  @map("registration_number")
  phone              String?
  email              String?
  currency           String   @default("LKR")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  subjects     Subject[]
  classes      Class[]
  teachers     Teacher[]
  staff        Staff[]
  students     Student[]
  enrollments  Enrollment[]
  attendance   Attendance[]
  payments     Payment[]
  transactions PaymentTransaction[]
  expenses     Expense[]
  advances     TeacherAdvance[]
  payouts      Payout[]
  users        User[]
  invitations  Invitation[]
  exams        Exam[]
  examResults  ExamResult[]
  topics       Topic[]
  tickets      SupportTicket[]

  @@map("institutes")
}

model Subject {
  id          String  @id @default(cuid())
  instituteId String  @map("institute_id")
  name        String
  code        String?

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  classes   Class[]
  topics    Topic[]

  @@index([instituteId])
  @@map("subjects")
}

model Class {
  id          String   @id @default(cuid())
  instituteId String   @map("institute_id")
  name        String
  grade       String?
  subjectId   String   @map("subject_id")
  medium      Medium
  /// Unassigned (null) when the teacher is removed.
  teacherId   String?  @map("teacher_id")
  dayOfWeek   String   @map("day_of_week")
  timeSlot    String   @map("time_slot")
  hall        String?
  monthlyFee  Int      @map("monthly_fee")
  createdAt   DateTime @default(now()) @map("created_at")

  institute       Institute    @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  subject         Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher         Teacher?     @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  primaryStudents Student[]
  enrollments     Enrollment[]
  attendance      Attendance[]
  payments        Payment[]
  exams           Exam[]

  @@index([instituteId])
  @@index([instituteId, grade])
  @@index([teacherId])
  @@index([subjectId])
  @@map("classes")
}

model Teacher {
  id          String           @id @default(cuid())
  instituteId String           @map("institute_id")
  /// Display name, kept as "firstName lastName".
  name        String
  firstName   String           @map("first_name")
  lastName    String           @map("last_name")
  phone       String
  whatsapp    String?
  email       String?
  nic         String?
  /// How `rate` is applied: % of class fees, per student, or per hour.
  rateType    CompensationType @map("rate_type")
  rate        Float
  subjectIds  String[]         @map("subject_ids")
  bankName    String?          @map("bank_name")
  bankAccount String?          @map("bank_account")
  createdAt   DateTime         @default(now()) @map("created_at")

  institute   Institute        @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  classes     Class[]
  advances    TeacherAdvance[]
  payouts     Payout[]
  users       User[]
  invitations Invitation[]

  @@index([instituteId])
  @@map("teachers")
}

model Staff {
  id            String       @id @default(cuid())
  instituteId   String       @map("institute_id")
  name          String
  firstName     String       @map("first_name")
  lastName      String       @map("last_name")
  role          String
  phone         String
  whatsapp      String?
  email         String?
  nic           String?
  /// Fixed monthly salary, or the daily / hourly wage (see payType).
  salary        Float
  payType       StaffPayType @default(MONTHLY) @map("pay_type")
  unitsPerMonth Int?         @map("units_per_month")
  status        ActiveStatus @default(ACTIVE)
  joinedOn      DateTime     @map("joined_on") @db.Date
  createdAt     DateTime     @default(now()) @map("created_at")

  institute Institute        @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  advances  TeacherAdvance[]
  payouts   Payout[]

  @@index([instituteId])
  @@index([instituteId, status])
  @@map("staff")
}

model Student {
  id               String    @id @default(cuid())
  instituteId      String    @map("institute_id")
  /// Primary (first) class; all classes are in `enrollments`.
  classId          String?   @map("class_id")
  name             String
  firstName        String    @map("first_name")
  lastName         String    @map("last_name")
  phone            String?
  parentName       String    @map("parent_name")
  parentPhone      String    @map("parent_phone")
  parentWhatsapp   String?   @map("parent_whatsapp")
  address          String?
  school           String?
  dateOfBirth      DateTime? @map("date_of_birth") @db.Date
  qrCode           String    @unique @map("qr_code")
  createdAt        DateTime  @default(now()) @map("created_at")

  institute    Institute            @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  class        Class?               @relation(fields: [classId], references: [id], onDelete: SetNull)
  enrollments  Enrollment[]
  attendance   Attendance[]
  payments     Payment[]
  transactions PaymentTransaction[]
  examResults  ExamResult[]

  @@index([instituteId])
  @@index([classId])
  @@map("students")
}

model Enrollment {
  id          String           @id @default(cuid())
  instituteId String           @map("institute_id")
  studentId   String           @map("student_id")
  classId     String           @map("class_id")
  enrolledAt  DateTime         @map("enrolled_at") @db.Date
  status      EnrollmentStatus @default(ACTIVE)

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class     Class     @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([studentId, classId])
  @@index([instituteId])
  @@index([classId, status])
  @@map("enrollments")
}

model Attendance {
  id          String           @id @default(cuid())
  instituteId String           @map("institute_id")
  classId     String           @map("class_id")
  studentId   String           @map("student_id")
  date        DateTime         @db.Date
  status      AttendanceStatus
  markedBy    MarkedBy         @default(MANUAL) @map("marked_by")
  createdAt   DateTime         @default(now()) @map("created_at")

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  class     Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId, date])
  @@index([instituteId, date])
  @@index([studentId])
  @@map("attendance")
}

/// A student's bill for one class in one billing cycle ("YYYY-MM").
model Payment {
  id             String        @id @default(cuid())
  instituteId    String        @map("institute_id")
  studentId      String        @map("student_id")
  classId        String        @map("class_id")
  billingCycle   String        @map("billing_cycle") @db.Char(7)
  /// Class fee before any discount.
  grossAmount    Int           @map("gross_amount")
  discount       Int           @default(0)
  discountType   DiscountType  @default(FIXED) @map("discount_type")
  discountReason String?       @map("discount_reason")
  /// What the student is billed (gross - discount).
  amountBilled   Int           @map("amount_billed")
  /// Sum of allocations against this bill (kept in step by the ledger service).
  amountPaid     Int           @default(0) @map("amount_paid")
  balance        Int
  status         PaymentStatus @default(PENDING)
  dueDate        DateTime      @map("due_date") @db.Date
  createdAt      DateTime      @default(now()) @map("created_at")

  institute   Institute           @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  student     Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class       Class               @relation(fields: [classId], references: [id], onDelete: Cascade)
  allocations PaymentAllocation[]

  @@unique([studentId, classId, billingCycle])
  @@index([instituteId, billingCycle])
  @@index([studentId])
  @@index([status, dueDate])
  @@map("payments")
}

/// Money received from a student; applied oldest bill first, the rest is credit.
model PaymentTransaction {
  id          String        @id @default(cuid())
  instituteId String        @map("institute_id")
  studentId   String        @map("student_id")
  amount      Int
  method      PaymentMethod
  reference   String?
  receivedAt  DateTime      @default(now()) @map("received_at")

  institute   Institute           @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  student     Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  allocations PaymentAllocation[]

  @@index([instituteId, receivedAt])
  @@index([studentId])
  @@map("payment_transactions")
}

model PaymentAllocation {
  id            String @id @default(cuid())
  transactionId String @map("transaction_id")
  paymentId     String @map("payment_id")
  amount        Int

  transaction PaymentTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  payment     Payment            @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([paymentId])
  @@map("payment_allocations")
}

model Expense {
  id          String         @id @default(cuid())
  instituteId String         @map("institute_id")
  title       String
  category    String
  amount      Int
  status      ExpenseStatus  @default(UNPAID)
  /// Bill date; its month is the cycle the expense belongs to.
  date        DateTime       @db.Date
  dueDate     DateTime?      @map("due_date") @db.Date
  paidOn      DateTime?      @map("paid_on") @db.Date
  /// Paid so far; the bill stays UNPAID until this reaches `amount`.
  amountPaid  Int            @default(0) @map("amount_paid")
  /// Instalments [{ id, date, amount, method? }], oldest first.
  payments    Json           @default("[]")
  vendor      String?
  method      PaymentMethod?
  classId     String?        @map("class_id")
  teacherId   String?        @map("teacher_id")
  createdAt   DateTime       @default(now()) @map("created_at")

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@index([instituteId, status])
  @@index([instituteId, date])
  @@map("expenses")
}

/// A salary advance to a teacher (or a staff member, payeeType STAFF).
model TeacherAdvance {
  id          String         @id @default(cuid())
  instituteId String         @map("institute_id")
  payeeType   PayeeType      @default(TEACHER) @map("payee_type")
  teacherId   String?        @map("teacher_id")
  staffId     String?        @map("staff_id")
  amount      Int
  /// Day the money is handed over; payouts deduct advances dated on/before their pay date.
  date        DateTime       @db.Date
  status      AdvanceStatus  @default(REQUESTED)
  /// Recovered so far through payouts.
  deducted    Int            @default(0)
  /// True once fully recovered (deducted >= amount).
  settled     Boolean        @default(false)
  method      PaymentMethod?
  note        String?
  createdAt   DateTime       @default(now()) @map("created_at")

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  teacher   Teacher?  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  staff     Staff?    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([instituteId])
  @@index([teacherId, date])
  @@index([staffId, date])
  @@map("teacher_advances")
}

/// A settled salary for one payee and cycle. Lines and deductions are frozen
/// at payment time so slips survive later edits or deletions.
model Payout {
  id           String        @id @default(cuid())
  instituteId  String        @map("institute_id")
  payeeType    PayeeType     @map("payee_type")
  payeeId      String        @map("payee_id")
  teacherId    String?       @map("teacher_id")
  staffId      String?       @map("staff_id")
  payeeName    String?       @map("payee_name")
  payeeRole    String?       @map("payee_role")
  period       String        @db.Char(7)
  lines        Json
  gross        Int
  deductions   Json
  advanceTotal Int           @map("advance_total")
  net          Int
  paidOn       DateTime      @map("paid_on") @db.Date
  method       PaymentMethod
  reference    String?
  /// Handed over so far; net - amountPaid is still owed to the payee.
  amountPaid   Int           @default(0) @map("amount_paid")
  /// Instalments [{ id, date, amount, method, reference? }], oldest first.
  payments     Json          @default("[]")
  receiptNo    String        @unique @map("receipt_no")
  createdAt    DateTime      @default(now()) @map("created_at")

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  teacher   Teacher?  @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  staff     Staff?    @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@unique([payeeType, payeeId, period])
  @@index([instituteId, period])
  @@map("payouts")
}

/// A sign-in account. The Super Admin has every permission everywhere; other
/// accounts are created from access codes with the permissions chosen then.
model User {
  id             String        @id @default(cuid())
  username       String        @unique
  displayName    String        @map("display_name")
  role           UserRole
  /// PBKDF2-SHA256: "pbkdf2$<iterations>$<salt hex>$<hash hex>".
  passwordHash   String        @map("password_hash")
  permissions    String[]
  /// Limited to this institute; null = every institute.
  instituteId    String?       @map("institute_id")
  /// Teacher record for "own classes only" accounts.
  teacherId      String?       @map("teacher_id")
  ownClassesOnly Boolean       @default(false) @map("own_classes_only")
  status         AccountStatus @default(ACTIVE)
  createdAt      DateTime      @default(now()) @map("created_at")
  lastLoginAt    DateTime?     @map("last_login_at")

  institute Institute? @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  teacher   Teacher?   @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  sessions  Session[]

  @@index([instituteId])
  @@map("users")
}

/// A single-use access code. Only the SHA-256 of the code is stored.
model Invitation {
  id             String           @id @default(cuid())
  codeHash       String           @unique @map("code_hash")
  codeHint       String           @map("code_hint")
  role           UserRole
  displayName    String           @map("display_name")
  permissions    String[]
  instituteId    String?          @map("institute_id")
  teacherId      String?          @map("teacher_id")
  ownClassesOnly Boolean          @default(false) @map("own_classes_only")
  expiresAt      DateTime         @map("expires_at")
  status         InvitationStatus @default(PENDING)
  createdAt      DateTime         @default(now()) @map("created_at")
  createdById    String?          @map("created_by_id")
  usedBy         String?          @map("used_by")
  usedAt         DateTime?        @map("used_at")

  institute Institute? @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  teacher   Teacher?   @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@index([status, expiresAt])
  @@map("invitations")
}

/// A signed-in session. Only the SHA-256 of the bearer token is stored.
model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique @map("token_hash")
  userId     String   @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at")
  expiresAt  DateTime @map("expires_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// An exam sat by one class.
model Exam {
  id           String   @id @default(cuid())
  instituteId  String   @map("institute_id")
  classId      String   @map("class_id")
  name         String
  date         DateTime @db.Date
  totalMarks   Int      @map("total_marks")
  passingMarks Int      @map("passing_marks")
  createdAt    DateTime @default(now()) @map("created_at")

  institute Institute    @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  class     Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  results   ExamResult[]

  @@index([instituteId, date])
  @@index([classId])
  @@map("exams")
}

model ExamResult {
  id          String   @id @default(cuid())
  instituteId String   @map("institute_id")
  examId      String   @map("exam_id")
  studentId   String   @map("student_id")
  marks       Float
  grade       String?
  createdAt   DateTime @default(now()) @map("created_at")

  institute    Institute     @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  exam         Exam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  topicResults TopicResult[]

  @@unique([examId, studentId])
  @@index([instituteId])
  @@map("exam_results")
}

/// A syllabus topic of a subject, used to find weak areas from exam marks.
model Topic {
  id          String @id @default(cuid())
  instituteId String @map("institute_id")
  subjectId   String @map("subject_id")
  name        String

  institute Institute     @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  subject   Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  results   TopicResult[]

  @@index([instituteId])
  @@map("topics")
}

model TopicResult {
  id           String @id @default(cuid())
  examResultId String @map("exam_result_id")
  topicId      String @map("topic_id")
  marks        Float

  examResult ExamResult @relation(fields: [examResultId], references: [id], onDelete: Cascade)
  topic      Topic      @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([examResultId])
  @@index([topicId])
  @@map("topic_results")
}

model SupportTicket {
  id          String         @id @default(cuid())
  instituteId String         @map("institute_id")
  /// Account that raised it (kept as text so tickets outlive accounts).
  userId      String?        @map("user_id")
  subject     String
  description String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@index([instituteId, status])
  @@map("support_tickets")
}
