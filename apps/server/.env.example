# Ceyora Backend API Server Environment Configuration
# Copy this file to .env or inject these variables into your production container/host.

# Node Environment
NODE_ENV=production
PORT=4000

# PostgreSQL Database Connection
# DATABASE_URL: Pooled connection string (e.g., Neon -pooler URL, Supabase pooler, PgBouncer, or RDS)
DATABASE_URL=postgresql://postgres:password@localhost:5433/ceyora?schema=public&sslmode=prefer
# DIRECT_URL: Direct non-pooled connection string (required for Prisma schema migrations)
DIRECT_URL=postgresql://postgres:password@localhost:5433/ceyora?schema=public&sslmode=prefer

# Cross-Origin Resource Sharing (comma-separated origins)
CORS_ORIGIN=http://localhost:3000,https://ceyora.lk,https://app.ceyora.lk

# Super Admin Provisioning Protection
# When set, creating the initial super-admin requires header: X-Setup-Token: <token>
SETUP_TOKEN=your_secure_random_setup_token_here

# PayHere Payment Gateway Credentials (Sri Lanka)
PAYHERE_MERCHANT_ID=1224890
PAYHERE_SECRET=897ab3c49ef01289de674a2110bc88
PAYHERE_SANDBOX=1

# Sri Lanka SMS Gateway (Dialog / Mobitel Esana / Twilio)
SMS_GATEWAY_PROVIDER=mobitel
SMS_API_URL=https://msmsenterprise.mobitel.lk/api/v1/sms/send
SMS_API_KEY=
SMS_SENDER_ID=CEYORA

# Sri Lanka PDPA (Act No. 9 of 2022) Compliance & Security
PDPA_AUDIT_LOG_ENABLED=1
PDPA_DATA_RETENTION_DAYS=2555

# HTTP Request Logging (1 = enabled, 0 = disabled)
LOG_REQUESTS=0
