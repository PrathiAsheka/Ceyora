# --- Database -------------------------------------------------------------
# Local: `docker compose up -d` starts PostgreSQL on port 5433.
# Vercel/Neon: DATABASE_URL = the pooled connection string (host contains "-pooler"),
#              DIRECT_URL   = the direct (non-pooled) connection string, used by migrations.
DATABASE_URL="postgresql://ceyora:ceyora@localhost:5433/ceyora?schema=public"
DIRECT_URL="postgresql://ceyora:ceyora@localhost:5433/ceyora?schema=public"

# --- Web app access -------------------------------------------------------
# Comma-separated origins allowed to call the API (your web app's URL on Vercel).
CORS_ORIGIN=http://localhost:3000,http://localhost:3005

# --- First-time setup -----------------------------------------------------
# A long random secret required to create the Super Admin on a fresh deployment.
# Set it on any public deployment, e.g. generate with:  openssl rand -hex 24
SETUP_TOKEN=

# --- Local only -----------------------------------------------------------
PORT=4000
# Log each request (method, path, status, time)
LOG_REQUESTS=0
